DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para desarrollo local con PostgreSQL 18
DB_ENGINE=postgresql
DB_NAME=passion_fitness
DB_USER=passion_fitness
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_SSLROOTCERT=
DB_CONN_MAX_AGE=60

# En producción establece DJANGO_DEBUG=False, dominios reales, HTTPS y
# DJANGO_CSRF_TRUSTED_ORIGINS con el origen público de la aplicación.